# Get all treemix files in folder
get_files <- function(category, m) {
  # Pattern to match all TreeMix output files for this category and m
  pattern <- paste0("Oxy_", category, "_([0-9]+)_m", m,"\\.(cov|covse|edges|modelcov|treeout|vertices|llik)\\.gz$")
  
  # List matching files
  files <- list.files(output_dir, pattern=pattern, full.names=TRUE)
  
  if(length(files) == 0) return(character(0))
  
  # Extract the common prefix by removing known suffixes
  prefixes <- sub("\\.(cov|covse|edges|modelcov|treeout|vertices)\\.gz$", "", basename(files))
  
  # Convert to numeric i-values for sorting
  i_vals <- as.numeric(sub(paste0(".*_([0-9]+)_m", m), "\\1", prefixes))
  
  # Sort by i
  prefixes <- prefixes[order(i_vals)]
  
  # Keep unique prefixes only
  unique(prefixes)
}
get_files("core", 0)

# Loop over categories and m values
for (cat in categories) {
  for (m in m_values) {
    cat("Plotting category =", cat, "m =", m, "\n")
    
    prefixes <- get_files(cat, m)  # get common prefixes only
    print(prefixes)
    
    if (length(prefixes) == 0) {
      warning(paste("No files found for category", cat, "and m =", m))
      next
    }
    
    n_trees <- length(prefixes)
    plots_per_page <- 6  # number of plots per page (2 cols x 3 rows)
    n_pages <- ceiling(n_trees / plots_per_page)
    
    # --- Overlay Trees ---
    pdf(file.path(plot_dir, paste0("TreeMix_overlay_", cat, "_m", m, ".pdf")),
        width=14, height=8)  # landscape
    for (page in 1:n_pages) {
      start <- (page-1)*plots_per_page + 1
      end <- min(page*plots_per_page, n_trees)
      page_prefixes <- prefixes[start:end]
      
      n_page_plots <- length(page_prefixes)
      n_col <- 2
      n_row <- ceiling(n_page_plots / n_col)
      par(mfrow=c(n_row, n_col), mar=c(2,2,2,2))
      
      for (p in page_prefixes) {
        # Only use prefix; do NOT append .treeout.gz
        tree_prefix <- file.path(output_dir, p)
        plot_tree(tree_prefix)
        title(main=paste("Tree:", basename(tree_prefix)), cex.main=0.8)
      }
    }
    dev.off()
    
  }
}


